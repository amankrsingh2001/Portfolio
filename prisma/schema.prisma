// Visitor analytics. Models map onto snake_case tables and columns.
// After editing: pnpm db:migrate:dev --name <change> (needs DATABASE_URL), then commit
// the new folder in prisma/migrations. `pnpm db:migrate` applies pending migrations.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One row per browser, identified by the first-party `vid` cookie.
model Visitor {
  id             String   @id
  firstSeen      DateTime @default(now()) @map("first_seen") @db.Timestamptz
  lastSeen       DateTime @default(now()) @map("last_seen") @db.Timestamptz
  visits         Int      @default(1)
  /// Only filled in when the visitor introduces themselves (terminal `hello`, contact form).
  name           String?
  email          String?
  company        String?
  /// Salted SHA-256 of the IP: tells repeat devices apart without storing the address.
  ipHash         String?  @map("ip_hash")
  /// Approximate, from the hosting provider's IP geolocation (city level at best).
  city           String?
  region         String?
  country        String?
  latitude       Float?
  longitude      Float?
  timezone       String?
  browser        String?
  browserVersion String?  @map("browser_version")
  os             String?
  osVersion      String?  @map("os_version")
  deviceType     String?  @map("device_type")
  deviceVendor   String?  @map("device_vendor")
  deviceModel    String?  @map("device_model")
  language       String?
  screen         String?
  /// First touch: where they came from on their first visit.
  referrer       String?
  utmSource      String?  @map("utm_source")
  utmMedium      String?  @map("utm_medium")
  utmCampaign    String?  @map("utm_campaign")
  events         Event[]

  @@map("visitors")
}

/// One row per thing a visitor did.
model Event {
  id        BigInt   @id @default(autoincrement())
  visitorId String   @map("visitor_id")
  sessionId String   @map("session_id")
  type      String
  path      String?
  detail    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  visitor   Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([createdAt], map: "events_created_at_idx")
  @@index([visitorId, createdAt], map: "events_visitor_idx")
  @@map("events")
}
